# Smart College Analytics System (SCAS) - Environment Variables
# Configure these in your Vercel Project Settings -> Environment Variables

# Flask Secret Key (used for session encryption)
SECRET_KEY=smart_college_secret_key_129847

# Database Connection URL (Optional - defaults to auto-seeded /tmp SQLite on Vercel)
#
# Option A: PostgreSQL (e.g. Neon, Supabase, Vercel Postgres)
# POSTGRES_URL=postgresql://user:password@host-or-pooler.domain.com:5432/neondb?sslmode=require
# or:
# DATABASE_URL=postgresql://user:password@host-or-pooler.domain.com:5432/neondb?sslmode=require
#
# Option B: MySQL (e.g. PlanetScale, TiDB, Aiven, Railway)
# DATABASE_URL=mysql+pymysql://username:password@host.domain.com:3306/scas_db

# SMTP Gmail Configuration (Optional - for real email alerts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
