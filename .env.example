# Smart College Analytics System (SCAS) - Environment Variables Example
# Set these variables in your Vercel Project Settings -> Environment Variables

# Flask Secret Key
SECRET_KEY=smart_college_secret_key_129847

# Database Connection URL (Optional - defaults to /tmp SQLite on Vercel)
# For remote MySQL (e.g. TiDB, Aiven, Railway, AWS RDS):
# DATABASE_URL=mysql+pymysql://username:password@host.domain.com:3306/scas_db
# For PostgreSQL (e.g. Supabase, Neon):
# DATABASE_URL=postgresql://username:password@host.domain.com:5432/scas_db

# SMTP Email Configuration (Optional - for real email alerts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
