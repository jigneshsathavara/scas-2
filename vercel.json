{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "templates/**",
        "static/**",
        "models/**",
        "routes/**",
        "app.py",
        "config.py",
        "email_utils.py",
        "seed.py"
      ],
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
